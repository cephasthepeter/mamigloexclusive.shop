{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Storefront (debug)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "vite: serve"
    },
    {
      "name": "API (debug)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "func: host start"
    }
  ],
  "compounds": [
    {
      "name": "Storefront + API (debug)",
      "configurations": ["Storefront (debug)", "API (debug)"],
      "stopAll": true
    }
  ]
}
